{
  "name": "librarian-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Librarian AI - Modern, AI-alapú digitális könyvtár és közösségi platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run db:generate",
    "dev": "npm run dev --workspace=@librarian/web",
    "build": "npm run db:generate && npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@librarian/web",
    "test": "npx tsx --test tests/system-security.test.mjs",
    "test:all": "npx tsx --test tests/system-security.test.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@librarian/database",
    "db:push": "npm run db:push --workspace=@librarian/database",
    "db:seed": "npm run db:seed --workspace=@librarian/database",
    "db:import:mega": "npm run import:mega --workspace=@librarian/web"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "zod": "^4.5.4"
  }
}
